{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "topology.json",
  "description": "Canonical network topology. Every value that was not detected or could not be resolved with sufficient confidence is null (scalars) or [] (collections).",
  "type": "object",
  "required": ["schema_version", "metadata", "devices", "links", "unresolved"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"type": "string"},
    "metadata": {"type": "object", "required": ["image", "width", "height"],
                 "properties": {"image": {"type": ["string", "null"]}, "width": {"type": "integer"}, "height": {"type": "integer"},
                                "pipeline_version": {"type": "string"}, "source": {"type": "string"}}},
    "devices": {"type": "array", "items": {"$ref": "#/$defs/device"}},
    "links": {"type": "array", "items": {"$ref": "#/$defs/link"}},
    "unresolved": {"type": "array", "items": {"type": "object", "required": ["kind", "reason"],
                   "properties": {"kind": {"enum": ["device_name", "address", "subnet_mask", "host_suffix", "network_label", "link_candidate"]},
                                  "reason": {"type": "string"}}}}
  },
  "$defs": {
    "nstr": {"type": ["string", "null"]},
    "nprefix": {"type": ["integer", "null"], "minimum": 0, "maximum": 32},
    "nconf": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "network": {"type": "object", "required": ["ip_address", "prefix_length", "subnet_mask", "network_address", "host_suffix"],
                "additionalProperties": false,
                "properties": {"ip_address": {"$ref": "#/$defs/nstr"}, "prefix_length": {"$ref": "#/$defs/nprefix"},
                               "subnet_mask": {"$ref": "#/$defs/nstr"}, "network_address": {"$ref": "#/$defs/nstr"},
                               "host_suffix": {"$ref": "#/$defs/nstr"}}},
    "link_network": {"type": "object", "required": ["network_address", "prefix_length", "subnet_mask"], "additionalProperties": false,
                     "properties": {"network_address": {"$ref": "#/$defs/nstr"}, "prefix_length": {"$ref": "#/$defs/nprefix"},
                                    "subnet_mask": {"$ref": "#/$defs/nstr"}}},
    "address": {"type": "object",
                "required": ["link_id", "ip_address", "prefix_length", "subnet_mask", "network_address", "host_suffix", "source", "confidence", "flags", "unresolved_reason", "provenance"],
                "properties": {"link_id": {"$ref": "#/$defs/nstr"}, "ip_address": {"$ref": "#/$defs/nstr"}, "prefix_length": {"$ref": "#/$defs/nprefix"},
                               "subnet_mask": {"$ref": "#/$defs/nstr"}, "network_address": {"$ref": "#/$defs/nstr"}, "host_suffix": {"$ref": "#/$defs/nstr"},
                               "source": {"enum": ["ocr_direct", "host_suffix_resolution", "host_suffix_only"]},
                               "confidence": {"$ref": "#/$defs/nconf"}, "flags": {"type": "array", "items": {"type": "string"}},
                               "unresolved_reason": {"$ref": "#/$defs/nstr"}, "provenance": {"type": "object"}}},
    "device": {"type": "object", "required": ["id", "type", "name", "network", "addresses", "confidence", "flags", "provenance"],
               "additionalProperties": false,
               "properties": {"id": {"type": "string"}, "type": {"type": "string"}, "name": {"$ref": "#/$defs/nstr"},
                              "network": {"$ref": "#/$defs/network"}, "addresses": {"type": "array", "items": {"$ref": "#/$defs/address"}},
                              "confidence": {"type": "object", "required": ["device_detection", "name", "network_information", "overall"],
                                             "additionalProperties": {"$ref": "#/$defs/nconf"}},
                              "flags": {"type": "array", "items": {"type": "string"}}, "provenance": {"type": "object"}}},
    "link": {"type": "object", "required": ["id", "source", "target", "network", "confidence", "flags", "provenance"],
             "additionalProperties": false,
             "properties": {"id": {"type": "string"}, "source": {"type": "string"}, "target": {"$ref": "#/$defs/nstr"},
                            "network": {"$ref": "#/$defs/link_network"},
                            "confidence": {"type": "object", "required": ["cable_detection", "source_endpoint", "target_endpoint", "network_label", "overall"],
                                           "additionalProperties": {"$ref": "#/$defs/nconf"}},
                            "flags": {"type": "array", "items": {"type": "string"}}, "provenance": {"type": "object"}}}
  }
}
