# Copy values to your process environment; the app does not load this file.
GROQ_API_KEY=
# Use a Groq Free-plan account. Paid accounts bill even these model IDs.
# Supported alternative: openai/gpt-oss-20b. No automatic model fallback.
NET2TF_PLAN_MODEL=openai/gpt-oss-120b
NET2TF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
NET2TF_RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
NET2TF_RETRIEVAL_BACKEND=hybrid
# Optional paths; defaults are relative to the checkout, not the working directory.
# NET2TF_KB_DIR=/absolute/path/to/kb
# NET2TF_INDEX_DIR=/absolute/path/to/index
