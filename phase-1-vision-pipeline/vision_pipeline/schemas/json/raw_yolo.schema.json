{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "raw_yolo.json",
  "description": "Network devices found by the detector. Coordinates: ORIGINAL image pixels.",
  "type": "object",
  "required": ["schema_version", "coordinate_system", "image", "detections"],
  "properties": {
    "schema_version": {"type": "string"},
    "coordinate_system": {"const": "original_image_pixels"},
    "image": {"$ref": "#/$defs/image"},
    "producer": {"type": "object"},
    "class_names": {"type": "array", "items": {"type": "string"}, "description": "read from the model, never hard-coded"},
    "detections": {"type": "array", "items": {
      "type": "object",
      "required": ["id", "class", "confidence", "bbox", "center"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "pattern": "^device_[0-9]{3,}$"},
        "class": {"type": "string"},
        "confidence": {"type": "number", "minimum": 0, "maximum": 1},
        "bbox": {"$ref": "#/$defs/bbox"},
        "center": {"$ref": "#/$defs/point"}
      }
    }}
  },
  "$defs": {
    "image": {"type": "object", "required": ["path", "width", "height"],
              "properties": {"path": {"type": "string"}, "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1}}},
    "point": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2},
    "bbox": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4, "description": "[x1, y1, x2, y2]"}
  }
}
